# --- API Ключи (LLM Providers) ---
KIE_API_KEY=your_kie_api_key_here
KIE_MODEL=DeepSeek-V3
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# --- Настройки биржи (Nado DEX on Ink L2) ---
# ⚠️ ВНИМАНИЕ: Если LIVE_TRADING_ENABLED=True, бот будет совершать РЕАЛЬНЫЕ сделки на Nado DEX.
# Никому не передавайте ваш INK_PRIVATE_KEY и не коммитьте файл .env в GitHub!
TRADING_ENGINE=NADO
NADO_NETWORK=TESTNET
LIVE_TRADING_ENABLED=False
NADO_LIVE_TRADING_ENABLED=False

# --- Web3 Wallet (Ink L2 / Nado DEX) ---
INK_PRIVATE_KEY=your_ink_private_key_here
INK_WALLET_ADDRESS=

# --- Telegram Настройки ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
PUBLIC_CHANNEL_ID=

# --- Торговые настройки ---
TRADING_PROFILE=BALANCED
LEVERAGE=10
STARTING_BALANCE=60.0
SCAN_INTERVAL_MINUTES=30
MAX_CONCURRENT_POSITIONS=2

# --- Настройки отдыха ---
TIMEZONE_OFFSET=3
REST_START_TIME=24:00
REST_END_TIME=00:00

# --- Настройки логирования ---
LOG_LEVEL=INFO

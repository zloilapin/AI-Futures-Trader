# API ключ для Google Gemini LLM (обязательно для работы агентов)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Данные для уведомлений Telegram (опционально для тестового запуска)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Настройки DEX и системы
NADO_DEX_URL=https://api.nado.exchange
LOG_LEVEL=INFO

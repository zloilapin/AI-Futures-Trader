# --- API Ключи ---
KIE_API_KEY=your_kie_api_key_here
KIE_MODEL=DeepSeek-V3
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# --- Настройки биржи ---
# ⚠️ ВНИМАНИЕ: Если LIVE_TRADING_ENABLED=True, бот будет совершать РЕАЛЬНЫЕ сделки.
# Никому не передавайте ваши KRAKEN_API ключи и не коммитьте файл .env в GitHub!
# PAPER или KRAKEN
TRADING_ENGINE=PAPER
LIVE_TRADING_ENABLED=False
KRAKEN_API_KEY=your_kraken_key_here
KRAKEN_API_SECRET=your_kraken_secret_here

# --- Telegram Настройки ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
PUBLIC_CHANNEL_ID=

# --- Торговые настройки ---
TRADING_PROFILE=BALANCED
LEVERAGE=10
STARTING_BALANCE=60.0
SCAN_INTERVAL_MINUTES=30
MAX_MARGIN_PCT=0.5

# --- Настройки отдыха ---
TIMEZONE_OFFSET=3
REST_START_TIME=19:00
REST_END_TIME=07:00

# --- Настройки логирования ---
LOG_LEVEL=INFO
